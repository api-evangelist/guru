{
  "opencollection": "1.0.0",
  "info": {
    "name": "Guru Analytics People API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "People",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getguru.com/api/v1/people/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get profile"
        },
        {
          "info": {
            "name": "Update profile",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getguru.com/api/v1/people/update"
          },
          "docs": "Update profile"
        },
        {
          "info": {
            "name": "List direct reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getguru.com/api/v1/people/direct-reports"
          },
          "docs": "List direct reports"
        }
      ]
    }
  ],
  "bundled": true
}