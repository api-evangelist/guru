          },
          "docs": "List card comments"
        },
        {
          "info": {
            "name": "Delete card comment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getguru.com/api/v1/cards/comments"
          },
          "docs": "Delete card comment"
        }
      ]
    }
